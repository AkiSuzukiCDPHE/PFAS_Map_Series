SourceFiltered <- SourceLong %>%
filter(!(Acronym %in% c("Sample Date", "Facility Name", "Facility Lat", "Facility Long", "Sample Lat", "Sample Long")))
#  Join the fields you removed above
SourceFinal <- SourceFiltered %>%
left_join(sample_dates, by = "Permit_Number") %>%
left_join(Facility_Name, by = "Permit_Number") %>%
left_join(Sample_Lat, by = "Permit_Number") |>
left_join(Sample_Long, by = "Permit_Number")
SourceFinal <- SourceFinal %>% select(-`Chemical Name`)
# Replace NDs with 0
SourceFinal1 <- SourceFinal %>%
mutate(Results = ifelse(Results == "ND", "0.0", Results))
# Transform the results column to numeric
SourceFinal1$Results <- as.numeric(SourceFinal1$Results)
class(SourceFinal1$Results)
# Round results column to 2 decimal place
# Round the 'Value' column to 1 decimal place
SourceFinal1$Results  <- round(SourceFinal1$Results , 1)
unique(SourceLong1$Permit_Number)
# Fix duplicated permit numbers using stringr to remove the "...##"
library(stringr)
# \\.\\.\\. matches the three dots
# .* matches every character following them
SourceLong1 <- SourceFinal1 |>
mutate(Permit_Number = str_remove(Permit_Number,"\\.\\.\\..*"))
Lat_Longs <- SourceLong1 |> select(Permit_Number, `Sample Lat`, `Sample Long`)
# Aggregate the data before transforming it
aggregated_data_max <- SourceLong1 %>%
group_by(Permit_Number,  Acronym, Facility_Name ) %>%
summarise(Max_Results = max(Results, na.rm = TRUE), .groups = "drop") %>%
# Fix: Replace -Inf with NA (which appears as a blank in Excel/CSVs)
mutate(Max_Results = ifelse(is.infinite(Max_Results), NA, Max_Results))
# Pivot the data, remove the beginning of the string for the PFAS columns, join the lat longs
Sourcewide1 <- aggregated_data_max %>%
pivot_wider(
id_cols = c("Permit_Number", "Facility_Name"),
names_from = Acronym,
values_from = Max_Results
) %>%
rename_with(~ gsub("Max_Results_", "", .), starts_with("Max_Results_")) |>
left_join(Lat_Longs, by = "Permit_Number")
