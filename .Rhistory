Dry_Cleaning_PASI <- Dry_Cleaning_PASI |> mutate(PFAS_Analyte=case_when(PFAS_Analyte == "PFUdA" ~ "PFUnA",
PFAS_Analyte == "PFDoA" ~ "PFDoDA",
PFAS_Analyte == "FOSA" ~ "PFOSA",
